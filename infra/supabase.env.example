# Apply to the official pinned Supabase Docker stack on the hotel server.
# NOT a complete Supabase environment file; merge these settings into its upstream template.
SITE_URL=https://workstel.pages.dev
ADDITIONAL_REDIRECT_URLS=https://workstel.pages.dev/
SUPABASE_PUBLIC_URL=https://workstel.gabot.my.id
API_EXTERNAL_URL=https://workstel.gabot.my.id/auth/v1
# Set Google callback to https://SUPABASE_HOSTNAME/auth/v1/callback in Google Cloud.
# Configure Google credentials ONLY on the server using the selected Docker stack's Auth settings.
# Never place credentials, JWT signing keys, database passwords or KEKs in VITE_* values.
# Disable open local-account registration. Provision approved staff through the admin API.
# Enable Google sign-in only with explicit membership provisioning and an external consent audience.
# Read by docker-compose.workstel-auth.yml. Fill in on the server only; leave false until verified.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google self-sign-up. Set both together, only after migration 202611070003 is applied.
SIGNUP_HOOK_ENABLED=false
DISABLE_SIGNUP=true
